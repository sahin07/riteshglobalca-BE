{
  "kind": "collectionType",
  "collectionName": "jobs",
  "info": {
    "singularName": "job",
    "pluralName": "jobs",
    "displayName": "Job Listing",
    "description": "Schema for open positions/careers"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "department": {
      "type": "string",
      "required": true
    },
    "location": {
      "type": "string",
      "required": true
    },
    "experience": {
      "type": "string",
      "required": true
    },
    "jobType": {
      "type": "enumeration",
      "enum": [
        "Full Time",
        "Part Time",
        "Contract",
        "Internship"
      ],
      "default": "Full Time",
      "required": true
    },
    "shortDescription": {
      "type": "text",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "responsibilities": {
      "type": "text",
      "required": true
    },
    "requirements": {
      "type": "text",
      "required": true
    }
  }
}
