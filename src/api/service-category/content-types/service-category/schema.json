{
  "kind": "collectionType",
  "collectionName": "service_categories",
  "info": {
    "singularName": "service-category",
    "pluralName": "service-categories",
    "displayName": "Service Categories"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "menuLabel": {
      "type": "string"
    },
    "position": {
      "type": "integer",
      "default": 0
    },
    "intro": {
      "type": "text"
    },
    "description": {
      "type": "richtext"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "subcategories": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::service-subcategory.service-subcategory",
      "mappedBy": "category"
    },
    "mainModule": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::main-module.main-module",
      "inversedBy": "categories"
    }
  }
}
