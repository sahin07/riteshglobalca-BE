{
  "kind": "singleType",
  "collectionName": "newsletters",
  "info": {
    "singularName": "newsletter",
    "pluralName": "newsletters",
    "displayName": "Newsletter Page",
    "description": "Content for the Newsletter subscription page"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "heroTitle": {
      "type": "string",
      "required": true
    },
    "heroDescription": {
      "type": "text",
      "required": true
    },
    "emailPlaceholder": {
      "type": "string",
      "required": true
    },
    "subscribeButtonText": {
      "type": "string",
      "required": true
    },
    "featuresTitle": {
      "type": "string",
      "required": true
    },
    "featuresDescription": {
      "type": "text",
      "required": true
    },
    "features": {
      "type": "component",
      "repeatable": true,
      "component": "newsletter.feature"
    },
    "privacyDisclaimer": {
      "type": "text",
      "required": true
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
