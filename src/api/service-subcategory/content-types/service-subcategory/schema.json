{
  "kind": "collectionType",
  "collectionName": "service_subcategories",
  "info": {
    "singularName": "service-subcategory",
    "pluralName": "service-subcategories",
    "displayName": "Services"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "menuLabel": {
      "type": "string"
    },
    "position": {
      "type": "integer",
      "default": 0
    },
    "intro": {
      "type": "text"
    },
    "description": {
      "type": "richtext"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::service-category.service-category",
      "inversedBy": "subcategories"
    },
    "services": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::service.service",
      "mappedBy": "subcategory"
    }
  }
}
