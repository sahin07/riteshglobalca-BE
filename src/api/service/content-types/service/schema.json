{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "Our Expertise / Solutions",
    "description": "Individual service pages like Company Incorporation"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "heroTitle": {
      "type": "string",
      "required": true
    },
    "heroSubtitle": {
      "type": "text"
    },
    "introQuote": {
      "type": "text"
    },
    "introDescription": {
      "type": "richtext"
    },
    "contentBlocks": {
      "type": "dynamiczone",
      "components": [
        "service.feature-grid",
        "service.rich-text-section",
        "service.process-section",
        "service.tabbed-rich-text",
        "service.contact-cta",
        "service.table-section",
        "service.tabbed-table-section"
      ]
    },
    "faqs": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::faq.faq"
    },
    "relatedBlogs": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::blog-post.blog-post"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "subcategory": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::service-subcategory.service-subcategory",
      "inversedBy": "services"
    }
  }
}
